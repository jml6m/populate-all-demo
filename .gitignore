# See http://help.github.com/ignore-files/ for more about ignoring files.

# Node
/node_modules
/supporting-probes/node_modules

# Build output
/dist

# Generated data — local generation only; reference/ is committed
/data/local/
/data/*
!/data/reference/
!/data/.gitkeep

# Benchmark reports — local/unofficial runs only; reference/ is committed
/reports/local/
/reports/*
!/reports/reference/
!/reports/.gitkeep

# Trace logs — local/unofficial runs only; reference/ is committed
/logs/local/
/logs/*
!/logs/reference/
!/logs/.gitkeep

# Supporting-probes results — local/unofficial runs only; reference/ is committed
/supporting-probes/results/local/
/supporting-probes/results/*
!/supporting-probes/results/reference/
!/supporting-probes/results/.gitkeep

# IDE
/.idea
/.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
!/logs/reference/**/*.log
npm-debug.log*

# Supporting probes generated DB
/supporting-probes/prisma/probe.db
/supporting-probes/obj/

# Supporting-probes build artifacts (generated by mvn/javac/dotnet during probe runs)
/supporting-probes/.hibernate-classpath
/supporting-probes/*.class
/supporting-probes/bin/
