    "probe:all": "tsx run-probes.ts --suite=all"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.1.4",
    "@mikro-orm/sqlite": "^7.1.4",
    "@prisma/client": "^7.8.0",
    "mongoose": "^9.6.3",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.0",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
