    "probe:all": "tsx run-probes.ts --suite=all"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.13",
    "@mikro-orm/sqlite": "^7.1.8",
    "@prisma/client": "^5.12.0",
    "mongoose": "^8.0.0",
    "prisma": "^5.12.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.0",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
