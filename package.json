{
  "name": "populate-all-demo",
  "version": "1.0.0",
  "description": "Traversing Directed Cyclic Graphs without depth boundaries",
  "main": "dist/generate.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').copyFileSync('src/generate-config.json','dist/generate-config.json')\"",
    "generate": "cross-env NODE_OPTIONS='--max-old-space-size=4096' tsx src/generate.ts",
    "generate:force": "cross-env POPULATE_ALL_FORCE=1 NODE_OPTIONS='--max-old-space-size=4096' tsx src/generate.ts",
    "experiment": "cross-env NODE_OPTIONS='--max-old-space-size=4096' tsx src/runner.ts",
    "experiment:force": "cross-env POPULATE_ALL_FORCE=1 NODE_OPTIONS='--max-old-space-size=4096' tsx src/runner.ts",
    "clean": "node scripts/clean-local.js",
    "npm:reinstall": "node scripts/reinstall.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "seedrandom": "^3.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/seedrandom": "^3.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-pkg": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
