{
  "name": "populate-all-demo",
  "version": "1.0.0",
  "description": "Traversing Directed Cyclic Graphs without depth boundaries",
  "main": "dist/generate.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').copyFileSync('src/generate-config.json','dist/generate-config.json')\"",
    "generate": "NODE_OPTIONS='--max-old-space-size=4096' tsx src/generate.ts",
    "experiment": "NODE_OPTIONS='--max-old-space-size=4096' tsx src/runner.ts",
    "npm:reinstall": "node scripts/reinstall.js",
    "charts": "tsx scripts/generate-charts.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "seedrandom": "^3.0.5",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^25.4.0",
    "@types/seedrandom": "^3.0.8",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-pkg": "^0.21.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
